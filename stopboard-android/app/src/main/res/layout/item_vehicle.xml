<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_vehicle_card"
    android:visibility="invisible">

    <TextView
        android:id="@+id/tv_vehicle_rank"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_rank_1"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tv_vehicle_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="@color/vehicle_1"
                android:textSize="72sp"
                android:textStyle="bold"
                android:lineSpacingExtra="0dp"
                android:shadowColor="@color/vehicle_1_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"/>

            <TextView
                android:id="@+id/tv_vehicle_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分钟"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tv_vehicle_crowd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="适 中"
                android:textColor="@color/crowd_medium"
                android:textSize="20sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_crowd_tag"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_vehicle_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5分20秒"
                android:textColor="@color/countdown_text"
                android:textSize="20sp"
                android:fontFamily="monospace"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/divider_dark"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/tv_vehicle_stations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还有3站"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/divider_dark"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/tv_vehicle_plate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="沪A·12345"
                android:textColor="@color/text_tertiary"
                android:textSize="18sp"
                android:fontFamily="monospace"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/progress_bg">

            <View
                android:id="@+id/progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="@drawable/bg_progress_fill"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
