FROM maven:3.9-eclipse-temurin-11 AS builder
WORKDIR /app
COPY pom.xml .
COPY common/pom.xml common/
COPY simulator/pom.xml simulator/
RUN mvn -pl common -am dependency:go-offline -B
COPY common/ common/
RUN mvn -pl common -am install -DskipTests -B
COPY simulator/ simulator/
RUN mvn -pl simulator -am package -DskipTests -B

FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=builder /app/simulator/target/simulator-*.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
