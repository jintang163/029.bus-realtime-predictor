.query-card {
  position: sticky;
  top: 0;
  z-index: 10;
  background: linear-gradient(135deg, #e6f7ff 0%, #f0f9ff 100%);
}

.line-badge {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: bold;
  min-width: 100rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.small-btn {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  min-height: auto;
  line-height: 1.4;
}

.font-bold {
  font-weight: bold;
}

.custom-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e6f7ff;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.vehicle-card {
  border-left: 8rpx solid #1890ff;
  transition: transform 0.2s ease;
}

.vehicle-card:nth-child(1) {
  border-left-color: #ff4d4f;
}
.vehicle-card:nth-child(2) {
  border-left-color: #faad14;
}
.vehicle-card:nth-child(3) {
  border-left-color: #52c41a;
}

.vehicle-header {
  align-items: flex-start;
}

.order-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  background: #1890ff;
}
.order-1 { background: linear-gradient(135deg, #ff7875 0%, #ff4d4f 100%); }
.order-2 { background: linear-gradient(135deg, #ffc53d 0%, #faad14 100%); }
.order-3 { background: linear-gradient(135deg, #95de64 0%, #52c41a 100%); }

.countdown-normal { color: #1890ff; }
.countdown-soon { color: #faad14; }
.countdown-urgent { color: #ff4d4f; animation: pulse 1s ease-in-out infinite; }

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.countdown-unit {
  color: #666;
  margin-left: 8rpx;
  margin-top: 12rpx;
  font-weight: normal;
}

.crowd-info {
  padding: 12rpx 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
  min-width: 120rpx;
}

.crowd-icon {
  font-size: 32rpx;
  letter-spacing: 4rpx;
  font-weight: bold;
}

.vehicle-detail {
  align-items: flex-start;
}

.detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.detail-item:nth-child(2) {
  align-items: center;
  border-left: 1rpx solid #f0f0f0;
  border-right: 1rpx solid #f0f0f0;
}

.detail-item:nth-child(3) {
  align-items: flex-end;
}

.detail-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.progress-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-1 { background: linear-gradient(90deg, #ff7875, #ff4d4f); }
.progress-2 { background: linear-gradient(90deg, #ffc53d, #faad14); }
.progress-3 { background: linear-gradient(90deg, #95de64, #52c41a); }

.update-time {
  text-align: center;
  padding: 24rpx 0 40rpx;
}
