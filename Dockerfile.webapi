FROM maven:3.9-eclipse-temurin-11 AS builder
WORKDIR /app
COPY pom.xml .
COPY common/pom.xml common/
COPY dal/pom.xml dal/
COPY traffic-model/pom.xml traffic-model/
COPY web-api/pom.xml web-api/
RUN mvn -pl common -am dependency:go-offline -B
COPY common/ common/
RUN mvn -pl common -am install -DskipTests -B
COPY dal/ dal/
RUN mvn -pl dal -am install -DskipTests -B
COPY traffic-model/ traffic-model/
RUN mvn -pl traffic-model -am install -DskipTests -B
COPY web-api/ web-api/
RUN mvn -pl web-api -am package -DskipTests -B

FROM eclipse-temurin:11-jre
WORKDIR /app
COPY --from=builder /app/web-api/target/web-api-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
